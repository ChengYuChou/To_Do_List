{
  "name": "todolist",
  "version": "1.0.0",
  "description": "待辦事項清單",
  "main": "main.js",
  "author": "ChouChengYu",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.zhouchengyu.todolist",
    "productName": "ToDoList",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChengYuChou/To_Do_List.git"
  },
  "bugs": {
    "url": "https://github.com/ChengYuChou/To_Do_List/issues"
  },
  "homepage": "https://github.com/ChengYuChou/To_Do_List#readme"
}